{
  // Lista de APIs del failover multi-API. Firmar con: dotnet run -- sign --in endpoints.payload.json --keys ./keys --out mora-endpoints.json
  // version, issuedAtUtc y expiresAtUtc los pone la herramienta.
  "minApiVersion": "1.30.0",
  "refreshIntervalMinutes": 360,
  // Subirlo SOLO para re-repartir clientes entre las APIs.
  "assignmentEpoch": 1,
  "endpoints": [
    { "id": "api-1", "baseUrl": "https://moraentretenimiento.com/api", "weight": 100, "enabled": true }
  ],
  // URLs que los reproductores no deben usar nunca más.
  "revoked": [],
  "manifestMirrors": [
    "https://trinnwong.github.io/mora-api-cfg/mora-endpoints.json"
  ]
}
